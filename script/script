pipeline = pipeline.to_crs(epsg=32612)
lakes = lakes.to_crs(epsg=32612)
rivers = rivers.to_crs(epsg=32612)

pipeline['length_m']= pipeline.geometry.length
pipeline['length_km']= pipeline['length_m']/1000
print(pipeline['length_m'])

pipeline['pressure']= np.random.randint(700,1200, len(pipeline))
pipeline['temperature']= np.random.uniform(10,45, len(pipeline))
pipeline['vibration']= np.random.uniform(0,10, len(pipeline))

pipeline['lake_dist_m']= pipeline.geometry.apply(lambda x: lakes.distance(x).min())
pipeline['river_dist_m']= pipeline.geometry.apply(lambda x: rivers.distance(x).min())

pipeline['water_dist_m']= pipeline[['lake_dist_m', 'river_dist_m']].min(axis=1)

from shapely.geometry import LineString

line= pipeline.geometry.iloc[0]
distance= np.linspace(0, line.length, 6)

segments= []

for i in range(len(distance)-1):
  start= line.interpolate(distance[i])
  end= line.interpolate(distance[i+1])
  seg= LineString([start,end])
  segments.append(seg)

segments_gdf= gpd.GeoDataFrame(
    {'segment_id': range(1,len(segments)+1)},
    geometry= segments,
    crs= pipeline.crs
)

segments_gdf['length_m']= segments_gdf.length
class Pipeline Segment:
   def __init__ (self, segment_id, geometry):
       self.segment_id= segment_id
       self.geometry= geometry

       self.pressure= None
       self.temperature= None
       self.vibration= None 
       self.water_distance= None

   def simulate_sensor(self):
      import random

      self.pressure= random.randint(700,1200)
      self.temperature= random.uniform(10,45)
      self.vibration= random.uniform(0,10)
